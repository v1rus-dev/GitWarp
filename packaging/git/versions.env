# Pinned inputs for packaging/git/fetch-or-build.sh. Sourced by the script.
# To update: see packaging/git/README.md ("Updating the pin").

# Linux and macOS: git is built from the upstream release tarball.
GIT_VERSION=2.56.0
GIT_TARBALL_URL=https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.56.0.tar.xz
GIT_TARBALL_SHA256=26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3

# Windows: MinGit (64-bit, non-busybox) from Git for Windows. The sum is the
# one published in the release notes of the tag below.
MINGIT_TAG=v2.56.0.windows.4
MINGIT_ZIP=MinGit-2.56.0.4-64-bit.zip
MINGIT_URL=https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.4/MinGit-2.56.0.4-64-bit.zip
